# Copy this file to api/.env and fill in the values. Never commit api/.env.

# Supabase: Project -> Connect -> ORMs -> Prisma. Replace [YOUR-PASSWORD] with your database password.
# Used by the running API (pooled connection, port 6543).
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Used for migrations and the seed script (session pooler, port 5432).
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Any long random string, for example: openssl rand -hex 32
JWT_SECRET=""

# Where the web app runs, so the browser is allowed to call the API (comma-separated for several).
WEB_ORIGIN="http://localhost:5173"

# AI briefing, through OpenRouter (openrouter.ai -> Keys). Optional: without it the briefing shows a clear error.
OPENROUTER_API_KEY=""
AI_MODEL="nvidia/nemotron-3-super-120b-a12b:free"

# Development only: AI_MOCK=1 makes the briefing use a rule-based demo instead of calling a model.
# AI_MOCK=1
